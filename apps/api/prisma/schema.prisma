generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String                @id
  email              String                @unique
  name               String?
  imageUrl           String?
  localAuth          LocalAuthCredential?
  documentsOwned     Document[]            @relation("DocumentOwner")
  documentMemberships DocumentMembership[]
  comments           Comment[]
  invitationsSent    Invitation[]          @relation("InvitationSender")
  revisions          Revision[]
  aiRequests         AiRequest[]
  exportJobs         ExportJob[]
  auditEvents        AuditEvent[]          @relation("AuditActor")
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
}

model LocalAuthCredential {
  userId       String   @id
  username     String   @unique
  passwordHash String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Document {
  id             String               @id
  ownerUserId    String
  title          String
  content        String
  richContent    Json?
  defaultRole    DocumentRole?
  archivedAt     DateTime?
  owner          User                 @relation("DocumentOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  memberships    DocumentMembership[]
  invitations    Invitation[]
  comments       Comment[]
  revisions      Revision[]
  aiRequests     AiRequest[]
  exportJobs     ExportJob[]
  auditEvents    AuditEvent[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([ownerUserId])
  @@index([updatedAt])
}

model DocumentMembership {
  id          String       @id @default(cuid())
  documentId  String
  userId      String
  displayName String?
  role        DocumentRole
  document    Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([documentId, userId])
  @@index([userId])
}

model Invitation {
  id             String       @id
  documentId     String
  invitedByUserId String
  inviteeEmail   String
  role           DocumentRole
  acceptToken    String
  tokenHash      String
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  document       Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  invitedByUser  User         @relation("InvitationSender", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([documentId, createdAt])
  @@index([inviteeEmail])
  @@index([tokenHash])
}

model Comment {
  id           String   @id
  documentId   String
  authorUserId String
  authorName   String?
  body         String
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  authorUser   User     @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([documentId, createdAt])
  @@index([authorUserId])
}

model Revision {
  revisionId      String    @id
  documentId      String
  authorUserId    String
  label           String
  snapshotId      String
  contentType     String
  parentRevisionId String?
  snapshotText    String
  title           String
  document        Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  authorUser      User      @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  parentRevision  Revision? @relation("RevisionLineage", fields: [parentRevisionId], references: [revisionId], onDelete: SetNull)
  childRevisions  Revision[] @relation("RevisionLineage")
  createdAt       DateTime

  @@index([documentId, createdAt])
  @@index([authorUserId])
  @@index([parentRevisionId])
}

model AiRequest {
  requestId              String          @id
  documentId             String
  requestedByUserId      String
  action                 AiAction
  status                 AiRequestStatus
  scope                  AiSelectionScope
  prompt                 String?
  selectedText           String?
  surroundingText        String?
  maskPersonalData       Boolean         @default(false)
  baseDocumentText       String
  sourceFingerprint      Json
  forcedCurrentFingerprint Json?
  proposal               Json?
  errorMessage           String?
  document               Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  requestedByUser        User            @relation(fields: [requestedByUserId], references: [id], onDelete: Cascade)
  queuedAt               DateTime
  startedAt              DateTime?
  completedAt            DateTime?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  @@index([documentId, queuedAt])
  @@index([requestedByUserId])
  @@index([status])
}

model ExportJob {
  exportJobId      String          @id
  documentId       String
  requestedByUserId String
  format           ExportFormat
  status           ExportJobStatus
  artifactKey      String?
  mimeType         String?
  errorMessage     String?
  document         Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  requestedByUser  User            @relation(fields: [requestedByUserId], references: [id], onDelete: Cascade)
  requestedAt      DateTime
  completedAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([documentId, requestedAt])
  @@index([requestedByUserId])
  @@index([status])
}

model AuditEvent {
  id           String   @id
  action       String
  actorUserId  String
  documentId   String?
  targetUserId String?
  metadata     Json?
  actorUser    User     @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Cascade)
  document     Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  occurredAt   DateTime
  createdAt    DateTime @default(now())

  @@index([documentId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([action, occurredAt])
}

enum DocumentRole {
  owner
  editor
  commenter
  viewer
}

enum AiAction {
  rewrite
  summarize
  translate
  restructure
}

enum AiRequestStatus {
  queued
  running
  succeeded
  failed
  cancelled
  stale
}

enum AiSelectionScope {
  document
  selection
}

enum ExportFormat {
  txt
  pdf
  docx
}

enum ExportJobStatus {
  queued
  running
  succeeded
  failed
}
