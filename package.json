{
  "name": "collaborative-document-editor",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "docs:check": "node scripts/check-docs.mjs",
    "e2e:check": "node scripts/check-e2e-setup.mjs",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "typecheck": "node scripts/run-typecheck.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@eslint/js": "^9.24.0",
    "eslint": "^9.24.0",
    "globals": "^15.15.0",
    "turbo": "^2.0.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.29.0",
    "vitest": "^3.1.1"
  }
}
