{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@repo/shared-types": ["packages/shared-types/src/index.ts"],
      "@repo/editor-schema": ["packages/editor-schema/src/index.ts"],
      "@repo/authz": ["packages/authz/src/index.ts"],
      "@repo/prompt-templates": ["packages/prompt-templates/src/index.ts"],
      "@repo/ui": ["packages/ui/src/index.ts"],
      "@repo/test-fixtures": ["packages/test-fixtures/src/index.ts"]
    }
  }
}

